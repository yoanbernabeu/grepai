---
import { navigation } from '../../utils/navigation';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;

function isActive(href: string): boolean {
  if (!currentSlug) return false;

  // Normalize: remove leading/trailing slashes and file extensions
  const normalizedSlug = currentSlug.replace(/\.(md|mdx)$/, '').replace(/^\/|\/$/g, '');
  const normalizedHref = href.replace(/^\/grepai\//, '').replace(/^\/|\/$/g, '');

  // Exact match comparison
  return normalizedSlug === normalizedHref;
}
---

<nav class="space-y-7" aria-label="Documentation">
  {navigation.map((section) => (
    <div>
      <h3 class="px-3 mb-2 text-xs font-semibold text-ink-muted">
        {section.title}
      </h3>
      <ul class="space-y-px">
        {section.items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="nav-link"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .nav-link {
    @apply block px-3 py-1.5 rounded-sm text-sm text-ink-muted transition-colors;
  }

  .nav-link:hover {
    @apply text-ink bg-paper-sunk/60;
  }

  /* The current page sits on the gold thread */
  .nav-link[aria-current='page'] {
    @apply text-ink font-medium;
    box-shadow: inset 2px 0 0 rgb(var(--gold));
    border-radius: 0 3px 3px 0;
  }
</style>
