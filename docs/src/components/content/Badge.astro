---
interface Props {
  text: string;
  variant?: 'default' | 'success' | 'warning' | 'caution' | 'note';
  size?: 'small' | 'medium';
}

const { text, variant = 'default', size = 'medium' } = Astro.props;

const variantClasses: Record<string, string> = {
  default: 'text-ink-muted border-rule',
  success: 'text-ink border-ink-muted',
  warning: 'text-gold-ink border-gold/70',
  caution: 'text-[#b4472f] border-[#b4472f]/60',
  note: 'text-ink-muted border-rule bg-paper-sunk/60',
};

const sizeClasses: Record<string, string> = {
  small: 'text-xs px-2 py-0.5',
  medium: 'text-sm px-2.5 py-1',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-sm border font-medium',
    variantClasses[variant],
    sizeClasses[size],
  ]}
>
  {text}
</span>
