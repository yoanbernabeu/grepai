---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const groups = [
  {
    title: 'Docs',
    links: [
      { label: 'Getting started', href: '/grepai/getting-started/' },
      { label: 'Installation', href: '/grepai/installation/' },
      { label: 'Quick start', href: '/grepai/quickstart/' },
      { label: 'Configuration', href: '/grepai/configuration/' },
    ],
  },
  {
    title: 'Features',
    links: [
      { label: 'Semantic search', href: '/grepai/search-guide/' },
      { label: 'Call graph tracing', href: '/grepai/trace/' },
      { label: 'MCP integration', href: '/grepai/mcp/' },
      { label: 'Workspaces', href: '/grepai/workspace/' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'Blog', href: '/grepai/blog/' },
      { label: 'Benchmark', href: '/grepai/blog/benchmark-grepai-vs-grep-claude-code/' },
      { label: 'Contributing', href: '/grepai/contributing/' },
      { label: 'GitHub', href: 'https://github.com/yoanbernabeu/grepai', external: true },
    ],
  },
];
---

<footer class="border-t border-rule bg-paper">
  <div class="gutter max-w-7xl mx-auto py-10 flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <Logo size={22} />
      <p class="mt-3 text-sm text-ink-muted">
        Semantic code search and call graph tracing for your terminal and your AI agents. Runs locally.
      </p>
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 sm:grid-cols-3 gap-x-12 gap-y-8 text-sm">
      {groups.map((group) => (
        <div>
          <h2 class="font-semibold text-ink">{group.title}</h2>
          <ul class="mt-3 space-y-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-ink-muted hover:text-ink transition-colors"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="gutter max-w-7xl mx-auto pb-8 text-xs text-ink-muted flex flex-col sm:flex-row gap-2 justify-between">
    <p>&copy; {currentYear} grepai. MIT license.</p>
    <p>
      Built by <a href="https://yoandev.co" target="_blank" rel="noopener noreferrer" class="link">YoanDev</a> and contributors.
      Illustrations generated with Gemini.
    </p>
  </div>
</footer>
