---
// Pagefind Search Component
const rawBase = import.meta.env.BASE_URL || '/grepai';
const basePath = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<div class="search-container">
  <button
    id="search-button"
    type="button"
    class="flex items-center gap-2 px-2.5 py-1.5 text-sm text-ink-muted bg-paper-raised border border-rule rounded-sm hover:text-ink hover:border-ink-muted transition-colors"
    aria-keyshortcuts="Meta+K Control+K"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.3-4.3"/>
    </svg>
    <span class="sr-only sm:not-sr-only">Search</span>
    <kbd aria-hidden="true" class="hidden md:inline-flex items-center px-1.5 py-0.5 text-[11px] font-sans text-ink-muted bg-paper-sunk rounded-sm">⌘K</kbd>
  </button>
</div>

<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Search documentation">
  <div id="search-backdrop" class="absolute inset-0 bg-ink/50"></div>

  <div class="relative flex items-start justify-center pt-[10vh] px-4">
    <div class="w-full max-w-2xl bg-paper-raised border border-rule rounded-md shadow-[0_24px_60px_-20px_rgb(0_0_0/0.45)] overflow-hidden">
      <div class="flex justify-between items-center px-4 py-2 border-b border-rule text-xs text-ink-muted">
        <span>Search the docs and blog</span>
        <button id="search-close" type="button" class="p-1 text-ink-muted hover:text-ink transition-colors rounded-sm" aria-label="Close search">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      </div>
      <div id="pagefind-container"></div>
    </div>
  </div>
</div>

<link rel="stylesheet" href={`${basePath}pagefind/pagefind-ui.css`} />

<style is:global>
  /* Pagefind UI, mapped onto the site tokens (the modal is the one elevated surface) */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: rgb(var(--gold-ink));
    --pagefind-ui-text: rgb(var(--ink));
    --pagefind-ui-background: rgb(var(--paper-raised));
    --pagefind-ui-border: rgb(var(--rule));
    --pagefind-ui-tag: rgb(var(--paper-sunk));
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-image-border-radius: 3px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: 'Public Sans', system-ui, sans-serif;
  }

  .pagefind-ui { padding: 0 !important; }

  .pagefind-ui__form {
    padding: 1rem !important;
    border-bottom: 1px solid rgb(var(--rule)) !important;
  }
  .pagefind-ui__form::before { background-color: rgb(var(--ink-muted)) !important; top: 30px !important; left: 30px !important; }

  .pagefind-ui__search-input {
    background: rgb(var(--paper)) !important;
    border: 1px solid rgb(var(--rule)) !important;
    color: rgb(var(--ink)) !important;
    font-size: 1rem !important;
    font-weight: 400 !important;
    border-radius: 3px !important;
  }
  .pagefind-ui__search-input:focus {
    border-color: rgb(var(--gold-ink)) !important;
    outline: none !important;
  }
  .pagefind-ui__search-input::placeholder { color: rgb(var(--ink-muted)) !important; opacity: 1 !important; }

  .pagefind-ui__search-clear { background: transparent !important; color: rgb(var(--ink-muted)) !important; }
  .pagefind-ui__search-clear:hover { color: rgb(var(--ink)) !important; }

  .pagefind-ui__drawer { padding: 0 1rem !important; }
  .pagefind-ui__results-area {
    max-height: 60vh !important;
    overflow-y: auto !important;
    margin-top: 0 !important;
  }
  .pagefind-ui__message {
    color: rgb(var(--ink-muted)) !important;
    font-size: 0.875rem !important;
    padding: 0.75rem 0 !important;
  }
  .pagefind-ui__result {
    padding: 0.9rem 0 !important;
    border-top: 1px solid rgb(var(--rule)) !important;
  }
  .pagefind-ui__result-link {
    color: rgb(var(--ink)) !important;
    font-weight: 600 !important;
  }
  .pagefind-ui__result-link:hover {
    text-decoration: underline !important;
    text-decoration-color: rgb(var(--gold)) !important;
  }
  .pagefind-ui__result-excerpt {
    color: rgb(var(--ink-muted)) !important;
    font-size: 0.875rem !important;
  }
  .pagefind-ui__result-nested {
    padding-left: 0.9rem !important;
    box-shadow: inset 2px 0 0 rgb(var(--gold) / 0.6) !important;
  }
  mark.pagefind-ui__result-highlight {
    background: rgb(var(--gold) / 0.3) !important;
    color: inherit !important;
    border-radius: 2px !important;
    padding: 0 0.15em !important;
  }
  .pagefind-ui__button {
    background: rgb(var(--paper)) !important;
    color: rgb(var(--ink)) !important;
    border: 1px solid rgb(var(--rule)) !important;
    border-radius: 3px !important;
    margin-bottom: 1rem !important;
  }
  .pagefind-ui__button:hover { border-color: rgb(var(--ink-muted)) !important; }
</style>

<script define:vars={{ basePath }}>
  // Load Pagefind UI script dynamically
  let pagefindLoaded = false;
  let pagefindInitialized = false;

  async function loadPagefind() {
    if (pagefindLoaded) return;

    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = `${basePath}pagefind/pagefind-ui.js`;
      script.onload = () => {
        pagefindLoaded = true;
        resolve(true);
      };
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  async function initPagefind() {
    const container = document.getElementById('pagefind-container');
    if (!container) return;

    try {
      await loadPagefind();

      // @ts-ignore
      new PagefindUI({
        element: container,
        showSubResults: true,
        showImages: false,
        baseUrl: basePath,
        translations: {
          placeholder: 'Search documentation...',
          zero_results: 'No results for "[SEARCH_TERM]"',
          many_results: '[COUNT] results',
          one_result: '1 result',
          searching: 'Searching...',
        },
      });

      pagefindInitialized = true;

      // Focus input after a small delay
      setTimeout(() => {
        const input = container.querySelector('.pagefind-ui__search-input');
        if (input) {
          input.focus();
        }
      }, 100);
    } catch (error) {
      console.error('Failed to load Pagefind:', error);
      container.innerHTML = '<p style="padding: 2rem; text-align: center; color: rgb(var(--ink-muted));">Search could not load. On a local dev server, run npm run build first.</p>';
    }
  }

  // Modal controls
  const searchButton = document.getElementById('search-button');
  const searchModal = document.getElementById('search-modal');
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchClose = document.getElementById('search-close');

  function openSearch() {
    if (!searchModal) return;
    searchModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    if (!pagefindInitialized) {
      initPagefind();
    } else {
      // Focus existing input
      setTimeout(() => {
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) {
          input.focus();
          input.select();
        }
      }, 50);
    }
  }

  function closeSearch() {
    if (!searchModal) return;
    if (searchModal.classList.contains('hidden')) return;
    searchModal.classList.add('hidden');
    document.body.style.overflow = '';
    searchButton?.focus();
  }

  // Event listeners
  searchButton?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  searchClose?.addEventListener('click', closeSearch);

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Cmd/Ctrl + K to open
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    // Escape to close
    if (e.key === 'Escape') {
      closeSearch();
    }
  });
</script>
