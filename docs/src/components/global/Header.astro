---
import Logo from './Logo.astro';
import Search from './Search.astro';
import { navigation } from '../../utils/navigation';

const navItems = [
  { label: 'Docs', href: '/grepai/getting-started/' },
  { label: 'Installation', href: '/grepai/installation/' },
  { label: 'Configuration', href: '/grepai/configuration/' },
  { label: 'Blog', href: '/grepai/blog/' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/grepai/blog/' ? path.startsWith('/grepai/blog') : path === href;
---

<header class="sticky top-0 z-50 w-full border-b border-rule bg-paper">
  <div class="gutter max-w-7xl mx-auto">
    <div class="flex items-center justify-between gap-4 h-16">
      <a href="/grepai/" class="flex items-center rounded-sm" aria-label="grepai home">
        <Logo size={26} />
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Main">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="px-3 py-2 text-sm font-medium text-ink-muted hover:text-ink transition-colors rounded-sm aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-gold aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center justify-end gap-1 sm:gap-2">
        <Search />

        <button
          type="button"
          id="theme-toggle"
          class="p-2 text-ink-muted hover:text-ink transition-colors rounded-sm"
          aria-label="Switch to dark theme"
        >
          <svg class="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
          </svg>
          <svg class="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>

        <a
          href="https://github.com/yoanbernabeu/grepai"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-ink-muted hover:text-ink transition-colors rounded-sm"
          aria-label="grepai on GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>

        <button
          type="button"
          id="sidebar-toggle"
          class="lg:hidden p-2 text-ink-muted hover:text-ink transition-colors rounded-sm"
          aria-label="Open menu"
          aria-controls="mobile-sidebar"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div id="sidebar-overlay" class="hidden fixed inset-0 bg-ink/40 z-40 lg:hidden"></div>
<aside
  id="mobile-sidebar"
  class="fixed top-16 left-0 w-72 max-w-[85vw] h-[calc(100dvh-4rem)] bg-paper border-r border-rule z-50 -translate-x-full transition-transform duration-200 lg:hidden overflow-y-auto invisible"
  aria-label="Documentation menu"
>
  <nav class="p-4 space-y-6">
    <ul class="space-y-1 pb-4 border-b border-rule">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="block px-3 py-2 text-sm font-medium text-ink hover:bg-paper-sunk rounded-sm">{item.label}</a>
        </li>
      ))}
    </ul>
    {navigation.map((section) => (
      <div>
        <h3 class="px-3 mb-2 text-xs font-semibold text-ink-muted">{section.title}</h3>
        <ul class="space-y-0.5">
          {section.items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="block px-3 py-1.5 text-sm text-ink-muted hover:text-ink hover:bg-paper-sunk rounded-sm aria-[current=page]:text-ink aria-[current=page]:font-medium aria-[current=page]:shadow-[inset_2px_0_0_rgb(var(--gold))]"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
  :global(:root[data-theme='dark']) .theme-icon-moon,
  :global(:root:not([data-theme='dark'])) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = 'true';

    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    sync();

    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('grepai-theme', next); } catch (e) { /* storage blocked */ }
      sync();
    });
  }

  function initMobileMenu() {
    const toggle = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('mobile-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!toggle || !sidebar || !overlay || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';

    const setOpen = (open: boolean) => {
      sidebar.classList.toggle('-translate-x-full', !open);
      sidebar.classList.toggle('invisible', !open);
      overlay.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) sidebar.querySelector('a')?.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    overlay.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  initThemeToggle();
  initMobileMenu();
  document.addEventListener('astro:page-load', () => {
    initThemeToggle();
    initMobileMenu();
  });
</script>
