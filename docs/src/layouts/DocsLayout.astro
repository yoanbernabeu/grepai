---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';
import Breadcrumbs from '../components/docs/Breadcrumbs.astro';
import Pagination from '../components/docs/Pagination.astro';
import CopyCodeButton from '../components/global/CopyCodeButton.astro';
import { sectionArt } from '../utils/sections';
import { responsiveArt } from '../utils/art';

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  section?: string;
  slug?: string;
}

const { title, description, headings = [], section, slug } = Astro.props;

const pageSlug = (slug ?? '').replace(/\.(md|mdx)$/, '');
const art = sectionArt(section);
const banner = art ? await responsiveArt(art.image, [640, 960, 1440]) : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    ...(description ? { description } : {}),
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'grepai documentation', url: 'https://yoanbernabeu.github.io/grepai/' },
    about: { '@type': 'SoftwareApplication', name: 'grepai', applicationCategory: 'DeveloperApplication' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'grepai', item: 'https://yoanbernabeu.github.io/grepai/' },
      ...(section ? [{ '@type': 'ListItem', position: 2, name: section }] : []),
      { '@type': 'ListItem', position: section ? 3 : 2, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={`/grepai/og/${pageSlug}.jpg`}
  imageAlt={`${title}, grepai documentation`}
  jsonLd={jsonLd}
  markdownUrl={`/grepai/${pageSlug}.md`}
>
  <Header />

  <div class="flex-1 flex">
    <!-- Sidebar -->
    <aside class="hidden lg:block w-64 flex-shrink-0">
      <div class="sidebar-container fixed top-16 w-64 h-[calc(100vh-4rem)] overflow-y-auto py-8 px-3 border-r border-rule bg-paper">
        <Sidebar currentSlug={slug} />
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 min-w-0">
      <div class="gutter max-w-3xl mx-auto py-10 lg:py-12">
        <Breadcrumbs section={section} title={title} />

        {art && banner && (
          <picture>
            <source type="image/avif" srcset={banner.avif} sizes="(min-width: 768px) 768px, 100vw" />
            <source type="image/webp" srcset={banner.webp} sizes="(min-width: 768px) 768px, 100vw" />
            <img
              src={banner.fallback}
              srcset={banner.jpeg}
              sizes="(min-width: 768px) 768px, 100vw"
              width={banner.width}
              height={banner.height}
              alt=""
              decoding="async"
              class="doc-banner"
              style={`object-position: ${art.focus}`}
            />
          </picture>
        )}

        <article class="prose max-w-none" data-pagefind-body>
          <h1 class="font-display font-normal text-[2.1rem] sm:text-[2.6rem] leading-[1.1] tracking-[-0.015em] mb-3">{title}</h1>
          {description && <p class="text-lg text-ink-muted mt-0 mb-10">{description}</p>}

          <slot />
        </article>

        <Pagination currentSlug={slug} />
      </div>
    </main>

    <!-- Table of Contents -->
    <aside class="hidden xl:block w-64 flex-shrink-0">
      <div class="fixed top-16 w-64 h-[calc(100vh-4rem)] overflow-y-auto py-12 px-4">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <Footer />

  <!-- Copy code button functionality -->
  <CopyCodeButton />

  <!-- Sidebar scroll persistence -->
  <script>
    const SCROLL_KEY = 'sidebar-scroll-position';

    function initSidebarScroll() {
      const sidebar = document.querySelector('.sidebar-container');
      if (!sidebar) return;

      // Restore scroll position
      const savedPosition = sessionStorage.getItem(SCROLL_KEY);
      if (savedPosition) {
        sidebar.scrollTop = parseInt(savedPosition, 10);
      }

      // Save scroll position on scroll
      sidebar.addEventListener('scroll', () => {
        sessionStorage.setItem(SCROLL_KEY, String(sidebar.scrollTop));
      });

      // Save position before navigation
      document.querySelectorAll('.sidebar-container a').forEach(link => {
        link.addEventListener('click', () => {
          sessionStorage.setItem(SCROLL_KEY, String(sidebar.scrollTop));
        });
      });
    }

    // Run on page load
    initSidebarScroll();

    // Re-run on Astro page transitions
    document.addEventListener('astro:page-load', initSidebarScroll);
  </script>

  <style>
    /* Section illustration: decorative, same world as the home page */
    .doc-banner {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 5;
      object-fit: cover;
      border-radius: 6px;
      margin-bottom: 2rem;
      background: #172629;
    }

    .sidebar-container {
      scrollbar-width: thin;
      scrollbar-color: rgb(var(--rule)) transparent;
    }
  </style>
</BaseLayout>
